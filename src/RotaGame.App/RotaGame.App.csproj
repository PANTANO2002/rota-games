<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>RotaGame</AssemblyName><Version>0.9.0</Version><ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets/RotaGame.ico</ApplicationIcon>
    <Authors>PANT_CORE</Authors><Company>PANT_CORE</Company><Copyright>Copyright © 2026 PANT_CORE</Copyright><Product>RotaGame · PANT_CORE</Product>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../RotaGame.Windows/RotaGame.Windows.csproj" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/RotaGame.ico" LogicalName="RotaGame.Assets.RotaGame.ico" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/Fonts/*.ttf" LogicalName="RotaGame.Assets.Fonts.%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
